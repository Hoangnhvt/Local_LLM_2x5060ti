# Copy to .env and edit
HF_TOKEN=hf_xxx_replace_me
LITELLM_MASTER_KEY=sk-local
LITELLM_PORT=4000

# Where HF models are cached on the host (mounted into all containers)
MODELS_DIR=/srv/models

# vLLM image — must support Blackwell (sm_120). 0.8.4+ or nightly.
# Used by AWQ stacks (coder-lg, coder-md, agent, reason, moe-fast).
VLLM_IMAGE=vllm/vllm-openai:v0.8.5

# vLLM image for NVFP4 stacks — needs >= 0.19.
VLLM_IMAGE_NVFP4=vllm/vllm-openai:v0.19.1

# Concurrency / memory tuning
GPU_MEM_UTIL=0.92
MAX_MODEL_LEN=32768

# NVFP4-specific tuning (32K is the safe ceiling on 2x16GB with FP8 KV)
NVFP4_MAX_LEN=32768
NVFP4_MAX_SEQS=2
